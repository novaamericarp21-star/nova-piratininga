# Endpoint que recebe o formulário de contato (POST JSON). Ex.: Formspree, API própria.
# Sem isso, o formulário abre o app de e-mail do visitante com a mensagem pronta.
VITE_CONTACT_ENDPOINT=

# Depois de rodar `npm run images:download`, mude para true para servir as fotos de /public/img.
VITE_LOCAL_IMAGES=false
